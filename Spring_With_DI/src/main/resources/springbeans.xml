<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE beans PUBLIC "-//SPRING//DTD BEAN 2.0//EN"
        "http://www.springframework.org/dtd/spring-beans-2.0.dtd">

<beans>
	<bean class="com.entity.Student"  >
		<constructor-arg index="0" value="100" />
		<constructor-arg index="1" value="Swapnil" />
		<constructor-arg index="2" value="23" />
		<constructor-arg index="3" value="A.Nagar" />
		<constructor-arg index="4" ref="course" />
	</bean>

	<bean class="com.entity.Course"  id="course">
		<constructor-arg index="0" value="101" />
		<constructor-arg index="1" value="JAVA" />
		<constructor-arg index="2" value="250" />
	</bean>
</beans>






